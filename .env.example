SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgres://threadline:threadline@db:5432/threadline
POSTGRES_DB=threadline
POSTGRES_USER=threadline
POSTGRES_PASSWORD=threadline
REDIS_URL=redis://redis:6379/0
TIME_ZONE=UTC
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=support@example.com
WEB_PORT=8000

MEDIA_STORAGE_BACKEND=local
# S3-compatible private media storage. Used only when MEDIA_STORAGE_BACKEND=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=auto

# Future email provider integration placeholders. These are not used yet.
EMAIL_PROVIDER_ENABLED=false
EMAIL_INBOUND_PROVIDER=
EMAIL_OUTBOUND_PROVIDER=
EMAIL_SUPPORT_ADDRESS=support@example.com

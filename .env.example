SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
USE_X_FORWARDED_PROTO=false
DATABASE_URL=postgres://threadline:threadline@db:5432/threadline
POSTGRES_DB=threadline
POSTGRES_USER=threadline
POSTGRES_PASSWORD=threadline
REDIS_URL=redis://redis:6379/0
TIME_ZONE=UTC
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=support@example.com
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
WEB_PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60

MEDIA_STORAGE_BACKEND=local
# S3-compatible private media storage. Used only when MEDIA_STORAGE_BACKEND=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=auto

# Optional OpenRouter attribution headers for AI provider requests.
OPENROUTER_SITE_URL=https://threadline.local
OPENROUTER_APP_TITLE=Threadline
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_ANALYSIS_MAX_TOKENS=2400
THREADLINE_FIELD_ENCRYPTION_KEY=
CELERY_LOG_LEVEL=INFO

# Workspace mailbox channels can enable IMAP inbound polling and SMTP outbound delivery.
# Store per-mailbox IMAP/SMTP secrets through Django admin or a trusted management path.
EMAIL_SUPPORT_ADDRESS=support@example.com
